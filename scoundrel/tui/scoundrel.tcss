Screen {
  align: center top;
}

#game-controls {
  height: auto;
  align: center middle;
}

#game-controls Button {
  margin: 1 5;
}

#game-controls Digits {
  border: solid red;
  text-align: center;
}

#room {
  margin: 2;
}

CardWidget {
  height: auto;
  margin: 1;
  padding: 2;
}

CardWidget Button {
  margin: 1;
  width: 100%;
  height: auto;
}

Image {
  height: auto;
  width: auto;
  margin: 1 5;
}

#attack {
  margin: 1
}

WeaponSlot {
  margin: 2;
}

.hidden {
  opacity: 0%;
}
